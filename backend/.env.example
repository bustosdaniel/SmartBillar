# Copia este archivo como .env y ajusta los valores.
# MySQL 8: usuario root con la contraseña que elegiste al instalarlo.
# Si la contraseña tiene símbolos (@ : / # ?), escríbelos codificados (ej. @ → %40).
DATABASE_URL=mysql+pymysql://root:TU_CONTRASEÑA@localhost:3306/smartbillar?charset=utf8mb4
# Clave para firmar los tokens de sesión (JWT). Genera una propia con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambia-esta-clave
# Origen del frontend (Vite) que puede llamar a la API.
CORS_ORIGENES=["http://localhost:5173"]
# Dirección del frontend: con ella se arma el enlace del correo de "Recuperar contraseña".
URL_FRONTEND=http://localhost:5173
# Correo (opcional). Sin SMTP_HOST el enlace solo se escribe en la consola del backend.
# Gmail: activa la verificación en dos pasos y crea una "contraseña de aplicación" en
#   https://myaccount.google.com/apppasswords  (16 letras, sin espacios).
# SMTP_HOST=smtp.gmail.com
# SMTP_PUERTO=587
# SMTP_USUARIO=tucorreo@gmail.com
# SMTP_CLAVE=abcdefghijklmnop
# CORREO_REMITENTE=SmartBillar <tucorreo@gmail.com>
# Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PUERTO=587 y el usuario y la clave SMTP de tu cuenta.

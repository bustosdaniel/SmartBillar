# Copia este archivo como .env y ajusta los valores.
# MySQL 8: usuario root con la contraseña que elegiste al instalarlo.
# Si la contraseña tiene símbolos (@ : / # ?), escríbelos codificados (ej. @ → %40).
DATABASE_URL=mysql+pymysql://root:TU_CONTRASEÑA@localhost:3306/smartbillar?charset=utf8mb4
# Clave para firmar los tokens de sesión (JWT). Genera una propia con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambia-esta-clave
# Origen del frontend (Vite) que puede llamar a la API.
CORS_ORIGENES=["http://localhost:5173"]
